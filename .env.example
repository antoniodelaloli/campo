NEXT_PUBLIC_SUPABASE_URL=https://TU_REFERENCIA.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# NUNCA pongas aquí la clave service_role con prefijo NEXT_PUBLIC_.

# --- Avisos en el móvil (migración 0005) ---
# Claves VAPID: se generan una vez con `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Contacto que se manda a Google/Apple con cada aviso (opcional).
VAPID_CONTACTO=mailto:tu-correo@ejemplo.com
# Clave SECRETA de Supabase (Project Settings → API Keys → Secret keys, empieza por sb_secret_).
# Solo la usa el servidor para el aviso diario. Sin NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Contraseña larga cualquiera: Vercel la manda al llamar al aviso diario.
CRON_SECRET=una-cadena-larga-y-aleatoria
